{
  "name": "@pos/api",
  "version": "0.1.0",
  "private": true,
  "description": "POS SaaS REST API (NestJS modular monolith).",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test:unit": "jest --config jest.config.js",
    "test:int": "jest --config test/jest-int.config.js --runInBand",
    "test": "pnpm test:unit && pnpm test:int",
    "db:migrate": "dotenv -e .env -- prisma migrate dev",
    "db:deploy": "dotenv -e .env -- prisma migrate deploy",
    "db:test:deploy": "dotenv -e .env.test -- prisma migrate deploy",
    "db:status": "dotenv -e .env -- prisma migrate status",
    "openapi": "dotenv -e .env -- node dist/scripts/export-openapi.js",
    "platform:admin": "dotenv -e .env -- node dist/scripts/platform-admin.js",
    "storage:init": "dotenv -e .env -- node dist/scripts/storage-init.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@aws-sdk/s3-request-presigner": "3.1152.0",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.1",
    "@pos/contracts": "workspace:*",
    "@pos/domain": "workspace:*",
    "@prisma/client": "6.19.3",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "nodemailer": "10.0.14",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.7",
    "@pos/config": "workspace:*",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@types/nodemailer": "7.0.12",
    "@types/supertest": "6.0.3",
    "dotenv-cli": "11.0.0",
    "jest": "30.5.2",
    "prisma": "6.19.3",
    "source-map-support": "0.5.21",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
