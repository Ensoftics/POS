# Copy to .env for local development. Never commit real credentials.
NODE_ENV=development
PORT=4000
APP_VERSION=0.1.0

# Runtime connection uses the restricted role so row-level security applies.
# Use 127.0.0.1, not localhost: on Windows "localhost" tries IPv6 first and each new
# pooled connection stalls ~2s before falling back (Docker publishes IPv4 only).
DATABASE_URL=postgresql://pos_app:pos_app_dev@127.0.0.1:5434/pos_dev?schema=public
# Migrations run as the schema owner.
MIGRATION_DATABASE_URL=postgresql://pos_owner:pos_owner_dev@127.0.0.1:5434/pos_dev?schema=public

# At least 32 random characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS_WEB=14
REFRESH_TOKEN_TTL_DAYS_MOBILE=30
SESSION_MAX_LIFETIME_DAYS=90
PASSWORD_RESET_TTL_MINUTES=30

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5180
WEB_APP_URL=http://localhost:5180
# Set true when running behind a reverse proxy / load balancer that sets X-Forwarded-For.
TRUST_PROXY=false
COOKIE_SECURE=false

# Development SMTP goes to Mailpit (http://localhost:8026).
SMTP_URL=smtp://127.0.0.1:1026
MAIL_FROM="Ensoftic POS <no-reply@localhost>"

RATE_LIMIT_DEFAULT_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=10
ENABLE_API_DOCS=true
LOG_FORMAT=pretty

PASSWORD_HASH_LOG_N=16

# Billing (Slice 11). Payments stay unavailable until PayHere credentials are set.
API_PUBLIC_URL=http://localhost:4000
TRIAL_DAYS=14
TRIAL_PLAN_CODE=GROWTH
GRACE_DAYS=7
BILLING_TAX_RATE_BP=0
BILLING_SWEEP_SECONDS=900
PAYHERE_MODE=sandbox
# PAYHERE_MERCHANT_ID=
# PAYHERE_MERCHANT_SECRET=

# Daily stock alerts and morning digest (Slice 13); 0 disables the timer.
NOTIFICATIONS_SWEEP_SECONDS=900

# Product images (Slice 13c). Local S3-compatible storage from infra/docker-compose.yml;
# create the bucket once with: pnpm --filter @pos/api storage:init
S3_ENDPOINT=http://127.0.0.1:8334
S3_REGION=us-east-1
S3_BUCKET=pos-dev
S3_ACCESS_KEY_ID=pos_storage_dev
S3_SECRET_ACCESS_KEY=pos_storage_dev_secret
S3_FORCE_PATH_STYLE=true

# Customer SMS (Slice 13f). SMS stays unavailable until all three are set.
# NOTIFYLK_USER_ID=
# NOTIFYLK_API_KEY=
# NOTIFYLK_SENDER_ID=
MESSAGING_SWEEP_SECONDS=20
