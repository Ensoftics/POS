# API settings for load tests (apps/api reads these with dotenv). A separate database:
#   docker exec ensoftic-pos-postgres-1 createdb -U pos_owner pos_load
NODE_ENV=production
PORT=4200
APP_VERSION=load
DATABASE_URL=postgresql://pos_app:pos_app_dev@127.0.0.1:5434/pos_load?schema=public&connection_limit=20
MIGRATION_DATABASE_URL=postgresql://pos_owner:pos_owner_dev@127.0.0.1:5434/pos_load?schema=public
JWT_ACCESS_SECRET=load-test-secret-not-for-production-0123456789
# Long enough for a whole run without token renewal in the scripts.
ACCESS_TOKEN_TTL_SECONDS=3600
CORS_ORIGINS=https://load.invalid
WEB_APP_URL=https://load.invalid
API_PUBLIC_URL=https://load.invalid
COOKIE_SECURE=true
SMTP_URL=smtp://127.0.0.1:1026
MAIL_FROM="Load test <no-reply@load.invalid>"
# All traffic comes from one IP here; production limits per real client IP.
RATE_LIMIT_DEFAULT_PER_MINUTE=1000000
RATE_LIMIT_AUTH_PER_MINUTE=100000
LOG_FORMAT=json
# Production cost: 64 MiB scrypt per password hash.
PASSWORD_HASH_LOG_N=16
BILLING_SWEEP_SECONDS=0
NOTIFICATIONS_SWEEP_SECONDS=0
MESSAGING_SWEEP_SECONDS=0
