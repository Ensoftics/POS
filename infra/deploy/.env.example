# Copy to .env on the server (chmod 600). Prefer the host's secret manager for the secrets.
RELEASE=2026.10.0
IMAGE_PREFIX=ensoftic-pos

# Public address (also the web origin and API_PUBLIC_URL host).
APP_DOMAIN=pos.example.lk
ACME_EMAIL=ops@example.lk

# PostgreSQL 17 (managed). Create the roles once with db-init.sql.
DATABASE_URL=postgresql://pos_app:CHANGE_ME@db.internal:5432/pos?schema=public&sslmode=require&connection_limit=20
MIGRATION_DATABASE_URL=postgresql://pos_owner:CHANGE_ME@db.internal:5432/pos?schema=public&sslmode=require

# At least 32 random characters: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CHANGE_ME
CORS_ORIGINS=https://pos.example.lk
WEB_APP_URL=https://pos.example.lk
API_PUBLIC_URL=https://pos.example.lk

SMTP_URL=smtps://user:CHANGE_ME@smtp.example.lk:465
MAIL_FROM="Ensoftic POS <no-reply@pos.example.lk>"
LOG_FORMAT=json

# Product images: a private bucket. IMAGE_ORIGIN is where signed image links redirect
# (allowed in the web app's Content-Security-Policy).
S3_BUCKET=ensoftic-pos-images
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
IMAGE_ORIGIN=https://ensoftic-pos-images.s3.ap-south-1.amazonaws.com

# Optional integrations (unavailable until set).
# PAYHERE_MERCHANT_ID=
# PAYHERE_MERCHANT_SECRET=
# PAYHERE_MODE=live
# NOTIFYLK_USER_ID=
# NOTIFYLK_API_KEY=
# NOTIFYLK_SENDER_ID=
