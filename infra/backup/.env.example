# Backup settings (copy to .env, chmod 600). Use a backup account that cannot touch
# production, ideally with another provider or region.
MIGRATION_DATABASE_URL=postgresql://pos_owner:CHANGE_ME@db.internal:5432/pos?sslmode=require
BACKUP_S3_ENDPOINT=https://s3.eu-central-1.wasabisys.com
BACKUP_S3_REGION=eu-central-1
BACKUP_S3_ACCESS_KEY_ID=CHANGE_ME
BACKUP_S3_SECRET_ACCESS_KEY=CHANGE_ME
BACKUP_BUCKET=ensoftic-pos-backups
# Store this passphrase in the company password manager as well: without it the backups cannot be read.
BACKUP_PASSPHRASE=CHANGE_ME
# The production image bucket (read access is enough for backups).
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_BUCKET=ensoftic-pos-images
RETENTION=35d
# Restore drills: a separate PostgreSQL server, never production.
DRILL_ADMIN_URL=postgresql://pos_owner:CHANGE_ME@drill-db.internal:5432/postgres
DRILL_APP_URL=postgresql://pos_app:CHANGE_ME@drill-db.internal:5432/DBNAME
